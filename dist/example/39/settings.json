{
  "scenarioId": "39",
  "version": "1.0.0",
  "fillerConfig": {
    "targetUrl": "/scenarios/39",
    "description": "Student directory table with realtime search filtering where clicking delete keeps row and replaces button with static 'Deleted' text",
    "search": {
      "inputSelector": "#studentSearchInput39",
      "resetButtonSelector": "#resetStudentsBtn39"
    },
    "table": {
      "tableSelector": "#student-table",
      "rowSelector": "tr[id^=\"student-row-\"]",
      "deleteButtonSelector": "button[id^=\"deleteBtn39_\"]",
      "deletedLabelSelector": "span[id^=\"deletedLabel39_\"]",
      "totalInitialRecords": 20,
      "columns": [
        { "index": 0, "name": "srNo", "label": "#" },
        { "index": 1, "name": "name", "label": "Name" },
        { "index": 2, "name": "fatherName", "label": "Father's Name" },
        { "index": 3, "name": "gender", "label": "Gender" },
        { "index": 4, "name": "class", "label": "Class" },
        { "index": 5, "name": "action", "label": "Action" }
      ]
    }
  }
}
